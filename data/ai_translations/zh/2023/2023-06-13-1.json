   "heroes": [],
   "blocks": [
    {
     "title": "排位不活跃改动",
     "body": "在上一个竞技赛季中未进行任何对局的玩家将变为不活跃状态。不活跃玩家不会显示排位级别和分组。预设职责模式中的每个职责可分别变为不活跃状态，而在开放职责中，玩家只有一个排位级别可变为不活跃状态。一旦不活跃玩家回归并在获胜五场后获得竞技更新，其排位级别和分组将再次可见。",
     "dev": null
    },
    {
     "title": "竞技未知英雄",
     "body": "竞技未知英雄回归，带来整整一个赛季的随机英雄对决！竞技挑战也一并回归，提供神秘头衔和竞技点数。",
     "dev": null
    },
    {
     "title": "竞技错误修复",
     "body": "改进了匹配系统为首次排队参加竞技比赛的玩家计算初始技能预估（即「MMR」）的方式。",
     "dev": null
    }
