    {
     "title": "综合改动",
     "body": "所有英雄的战斗中治疗减免效果从30%降低至15%。",
     "dev": null
    },
    {
     "title": "重装职责被动",
     "body": "受到伤害或治疗时，终极技能充能减免从20%提高至40%。",
     "dev": null
    },
    {
     "title": "副职责被动",
     "body": "斗士 移动速度加成从20%降低至15%。 先锋 治疗量从50点降低至40点。 冷却时间从5秒缩短至4秒。 奇袭 急救包提供的额外生命值从75点降低至50点。 医疗 治疗转化率从40%降低至30%。",
     "dev": null
    }
   ]
  },
