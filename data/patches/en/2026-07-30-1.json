    {
     "title": "General Changes",
     "body": "- In-Combat Healing Reduction reduced from 30% to 15% for all heroes.",
     "dev": null
    },
    {
     "title": "Tank Role Passive",
     "body": "- Ultimate charge reduction when damaging or healing tank targets increased from 20% to 40%.",
     "dev": null
    },
    {
     "title": "Subrole Passives",
     "body": "Bruiser\n\n- Movement speed buff reduced from 20% to 15%.\n\nInitiator\n\n- Healing reduced from 50 to 40.\n- Cooldown reduced from 5 to 4 seconds.\n\nFlanker\n\n- Additional health from Health Packs reduced from 75 to 50.\n\nMedic\n\n- Healing conversion reduced from 40% to 30%.",
     "dev": null
    }
   ]
  },
