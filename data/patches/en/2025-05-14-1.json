   "blocks": [
    {
     "title": "Economy",
     "body": "- Increased bounty cap to 3000 (up from 2000).",
     "dev": "Developer Comments: Bounties are intended as a comeback mechanic, and we feel like the current cap can increase to maximize that potential."
    },
    {
     "title": "Armory",
     "body": "- Reduced timer from 100 seconds to 75 seconds in round 1 and 3.\n- Reduced timer from 75 seconds to 60 seconds in round 2.",
     "dev": "Developer Comments: We are reducing the amount of time you can shop during early rounds. We find that players need this time later in the game as they as are selling and countering, but it's not as useful up front."
    }
   ],
   "maps": []
  },
