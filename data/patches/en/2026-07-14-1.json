 "sections": [
  {
   "type": "generic_update",
   "title": "Summer Games 2026",
   "role": null,
   "description": "Summer Games 2026 is LIVE, bringing your favorite beach brawls back to the arcade! Blast into Lucioball, crank things up with Lucioball Remix, or serve up some fun in Winston's Beach Volleyball while completing challenges to earn sizzling summertime loot. Soak up the sun and earn a shining victory in Summer Games 2026, July 14 – 30!",
   "heroes": [],
   "blocks": []
  },
  {
   "type": "generic_update",
   "title": "Junkrat's Loot Hunt",
   "role": null,
   "description": "Junkrat’s Loot Hunt returns from July 31 - August 3 for a reward-fueled weekend blast! Every match you play pushes you closer to Loot Boxes, with flexible challenges that let you go all-in or pace yourself. Plus, progress won't reset, there's no daily pressure, and no nonsense… just explosions, and piles of loot to unbox!",
   "heroes": [],
   "blocks": []
  },
  {
   "type": "generic_update",
   "title": "Excavation Initiative",
   "role": null,
   "description": "The Excavation Initiative continues, rewarding you for doing what you'd already be doing: playing Overwatch. Throughout the rest of the season, you'll earn Loot Boxes simply by logging in, completing challenges, winning games, and staying active week after week. The more you play, the more opportunities you'll have to uncover Base, Epic, and Legendary Loot Boxes packed with rewards.",
   "heroes": [],
   "blocks": []
  },
