   "dev": null,
   "heroes": [],
   "blocks": [
    {
     "title": "GENERAL",
     "body": "- Names will no longer be revealed when blocking someone with Streamer Mode enabled.\n- Fixed a bug that allowed non-leader players to select the Requeue button.\n- Fixed a lighting issue that caused several sprays to look oversaturated.",
     "dev": null
    },
    {
     "title": "MAPS",
     "body": "Hanamura\n\n- We have fixed an issue with the lighting on Hanamura (Assault). This map is now available to play in the Assault Arcade mode and in Custom Games.",
     "dev": null
    },
    {
     "title": "HEROES",
     "body": "D.Va\n\n- Fixed a bug that caused some pings from D.Va to enter several 0's into the chat.\n\nVenture\n\n- Fixed an issue with Drill Dash that could occur when interacting with Doomfist's Rocket Punch or Orisa's Energy Javelin, sending Venture flying back at a great speed.",
     "dev": null
    }
   ],
   "maps": []
  }
