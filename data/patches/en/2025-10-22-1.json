  {
   "type": "generic_update",
   "title": "Bug Fixes",
   "role": null,
   "description": null,
   "heroes": [],
   "blocks": [
    {
     "title": "General",
     "body": "Capturing multikills is now correctly Play of Game's highest priority. This fix is applied to all game modes.",
     "dev": null
    },
    {
     "title": "Stadium Bug Fixes",
     "body": "Fixed an issue where lava spawned by Torbjorn's Power Magmini occasionally had full duration and damage. Fixed an issue where Torbjorn's Power Magmini would trigger On Ultimate Charge Spent effects. Fixed an issue where Refresher would permanently reduce the cooldown of both Genji and Pharah. Fixed an issue where picking Lucio's Power Reverb would change Soundwave's position in the HUD. Fixed an issue where Ana's biotic grenade with Falconer and Nanonade would give ultimate charge before the battle began. Fixed an issue where Hazard's Jagged Wall pre-placement would trigger on ability items.",
     "dev": null
    }
   ]
  }
