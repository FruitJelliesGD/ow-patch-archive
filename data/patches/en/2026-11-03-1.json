 "title": "Overwatch Retail Patch Notes – November 3, 2026",
 "seq": 1,
 "sections": [
  {
   "type": "generic_update",
   "title": "Taking Reign",
   "role": null,
   "description": "**Taking Reign** will be live 11/3 - 12/7. Play games and complete challenges to earn exclusive event rewards or upgrade to earn premium rewards, like a Legendary Doomfist skin and Legendary Vendetta weapon skin. Once purchased, Premium Event Passes can be completed at any time, even after the season/event ends.",
   "dev": null,
   "heroes": [],
   "blocks": [],
   "maps": []
  },
  {
   "type": "generic_update",
   "title": "OWCS World Finals Cheer Rally",
   "role": null,
   "description": "Complete Challenges & Collect Cheer!\n\n- Play matches and complete challenges to earn Cheers from November 24 to December 7.\n- Additional Cheers can be earned through watching OWCS World Finals broadcasts on official channels from December 2 through December 6.\n- Check out the OWCS World Finals Cheer Rally event page where you can Cheer on the competition. Earn rewards as a thank you for supporting the even - lootboxes, Battle Pass XP, and awesome cosmetics!",
   "dev": null,
   "heroes": [],
   "blocks": [],
   "maps": []
  },
  {
   "type": "generic_update",
   "title": "Drive Signature Customization",
   "role": null,
   "description": "Signature customization allows you to equip any Signatures you earned in previous seasons once you reach the FOURTH checkpoint in the most recent Drive. Reaching the FOURTH Checkpoint in the most recent Team Drive also allows the same type of customization for Player Card Frames. Hurray for color-coded profiles and a chaotically-colored lobby board!",
   "dev": null,
   "heroes": [],
   "blocks": [],
   "maps": []
  },
  {
   "type": "generic_update",
   "title": "Junkrat's Loot Hunt + Double XP Weekend",
   "role": null,
   "description": "Junkrat's Loot Hunt returns from 11/19 - 11/23 for a reward-fueled weekend blast, this time with the added bonus of Double XP! Every match you play pushes you closer to Loot Boxes, with flexible challenges that let you go all-in or pace yourself. Plus, progress won't reset, there's no daily pressure, and no nonsense... just explosions, and piles of loot to unbox!",
   "dev": null,
   "heroes": [],
   "blocks": [],
   "maps": []
  },
  {
   "type": "generic_update",
   "title": "Excavation Initiative",
   "role": null,
   "description": "The Excavation Initiative is back from 11/3-12/7 with some changes! You'll earn Loot Boxes by logging in and winning a game. Do this multiple weeks to earn rewards - Base, Epic, and Legendary Loot Boxes await those who complete the challenges.",
   "dev": null,
   "heroes": [],
   "blocks": [],
   "maps": []
  },
  {
   "type": "generic_update",
   "title": "General Updates",
   "role": null,
   "description": null,
   "dev": null,
   "heroes": [],
   "blocks": [
    {
     "title": "Gameplay Sabotage Detection",
     "body": "We're improving our tools to combat gameplay sabotage in Overwatch. We have made improvements to our current detection tools that allow us to more accurately detect players engaging in disruptive behaviors, and we've already taken action against many players detected by these systems. Examples of gameplay sabotage include consistently and intentionally failing to contribute to team fights, repeatedly jumping off the map, and intentionally blocking team progress. We will also continue to iterate on these detection methods so that we can catch even more players who are intentionally making other players' experiences worse.\n\nAs part of this update, we have also rolled out 'Thank You' messages for reporting a player for disruptive behaviors. You will see these show up in the game's Notification Hub if you report a player for disruptive behaviors, and appropriate actions have been taken against them.",
     "dev": null
    }
   ],
   "maps": []
  },
