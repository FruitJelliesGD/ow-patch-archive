  {
   "type": "generic_update",
   "title": "Bug Fixes",
   "role": null,
   "description": null,
   "heroes": [],
   "blocks": [
    {
     "title": "General",
     "body": "In a previous update, fixed a bug that resulted in Ashe's Take Aim damage falling off too quickly.",
     "dev": null
    },
    {
     "title": "Stadium",
     "body": "Fixed a bug where Reaper's Wall of Life and Death Power would not heal allies if they were not within range upon initial cast. Fixed a bug where casting Dragonblade while Deflecting with Dragon's Breath and Iaido Strike Powers equipped would not properly trigger Dragon's Breath. Fixed a bug with Ashe's Calamity Power that allowed players to acquire more ammo than intended. Fixed a bug with Moira's Chain Grasp Power where Biotic Grasp would only chain to 1 additional target. Fixed a bug where D.Va's Dae-Hyun Detonator Hero Item would not grant 15% starting Ultimate Charge. Fixed a bug where Mei's Ice Sheet Hero Item was not granting the correct stats. Fixed a bug where Ana's Cluster Core Item was not granting Ability Power. Fixed a bug where Soldier: 76's Rapid Response Radius Item did not increase Biotic Field's duration. Fixed a bug where Kiriko's Good Fortune Power did not work with Projectile Speed. Fixed a bug where Biotic Bullseye's effect would trigger off Three Tap Tommygun's DOT. Fixed a bug where Exo Springs still counted as a Gadget for certain items. Fixed a bug where Wuyang's Waveshatter didn't affect Splash Strike's damage. Fixed a bug where Genji's Dragon Strike would prevent Dragon Blade's Ultimate VO to play. Fixed a bug where Genji's Cybernetic Speed Power granted less Attack Speed than intended. Fixed a bug where Reinhardt's Iron Drift did not properly knock back enemies when cancelling Charge. Fixed a bug where Wuyang's Current Confluence would heal allies for less than intended. Fixed a bug where using Gadgets on D.Va would not trigger certain Item effects. Fixed a bug where combining Necrotic Repellant and Repulsion Greaves would cause Repulsion Greave's knockback effect to also hinder. Fixed a bug where Moira's Spectral Beam power would shorten Coalescence Duration if used in quick succession.",
     "dev": null
    }
   ]
  }
 ],
