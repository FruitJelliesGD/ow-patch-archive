  {
   "type": "generic_update",
   "title": "Stadium Updates",
   "role": null,
   "description": "Following the recent sweeping Stadium changes, we've been keeping a close eye on the performance of all heroes, their powers, and items. We're tuning down some early overperformers while buffing some of the underperforming new powers to help them find a clearer niche. We'll continue to monitor some of the more frustrating powers and items and make adjustments as necessary.",
   "dev": null,
   "heroes": [],
   "blocks": [
