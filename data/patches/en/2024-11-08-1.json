  {
   "type": "generic_update",
   "title": "Overwatch: Classic",
   "role": null,
   "description": "For both new and seasoned Overwatch fans, this three-week event beginning November 12 offers a chance to step back in time and experience the thrilling origins of Overwatch. Revisit iconic maps, enjoy the original hero roster featuring their classic abilities, and embrace the chaotic fun of 6v6 with no-limit team compositions.",
   "heroes": [],
   "blocks": []
  },
  {
   "type": "generic_update",
   "title": "Warcraft: 30 Anniversary",
   "role": null,
   "description": "To commemorate three decades of Warcraft, log in any time from November 15 to November 22 and receive free rewards as a celebration gift!",
   "heroes": [],
   "blocks": []
  },
