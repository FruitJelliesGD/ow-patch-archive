{"ts": "2026-09-09T08:18:21Z", "kind": "modified", "patch_id": "cn-2026-09-09-1", "site": "cn", "date": "2026-09-09", "title": "《守望先锋》补丁说明——2026年9月9日", "url": "https://ow.blizzard.cn/news/patch-notes/live/2026/09/", "diff": [{"path": "sections[2].heroes[0].abilities[1].name_en", "old": null, "new": "Power Barrier"}, {"path": "sections[2].heroes[0].abilities[2].name_en", "old": null, "new": "Call Mech"}, {"path": "sections[2].heroes[0].abilities[3].name_en", "old": null, "new": "Portable Fusion Repeater"}, {"path": "sections[2].heroes[0].abilities[3].slug", "old": "fusion-repeater", "new": "portable-fusion-repeater"}, {"path": "sections[2].heroes[0].general[0]", "old": {"text_en": null, "text_cn": "护甲从325点降低至300点。（6v6）", "subject": "health", "dimension": "hero_attr", "before": 325.0, "after": 300.0, "by": -25.0, "by_pct": null, "metric": "armor", "unit": "hp"}, "new": "护甲从325点降低至300点。（6v6）"}, {"path": "sections[2].heroes[1].general[0]", "old": {"text_en": null, "text_cn": "机甲的基础生命值从175点提高至200点。（5v5）", "subject": "health", "dimension": "hero_attr", "before": 175.0, "after": 200.0, "by": 25.0, "by_pct": null, "metric": "机甲的基础生命值", "unit": "hp"}, "new": "机甲的基础生命值从175点提高至200点。（5v5）"}, {"path": "sections[2].heroes[2].general[0]", "old": {"text_en": null, "text_cn": "终极技能消耗降低6%。", "subject": "ultimate_cost", "dimension": "hero_attr", "before": null, "after": null, "by": null, "by_pct": 6.0, "metric": "ultimate_cost", "unit": null}, "new": "终极技能消耗降低6%。"}, {"path": "sections[2].heroes[3].general[0]", "old": {"text_en": null, "text_cn": "基础护甲从150点降低至125点。", "subject": "health", "dimension": "hero_attr", "before": 150.0, "after": 125.0, "by": -25.0, "by_pct": null, "metric": "基础护甲", "unit": "hp"}, "new": "基础护甲从150点降低至125点。"}, {"path": "sections[2].heroes[6].abilities[0].name_en", "old": null, "new": "Particle Barrier"}, {"path": "sections[3].heroes[0].dev_note", "old": "设计师观点：“熠闪舞”可能会造成较为严重的视觉干扰，导致玩家难以在激烈战斗中追踪安燃的行动。为了提升清晰度，我们移除了可见的视觉分身。我们还缩短了“朱魂返”的施放时间，从而削减短对手的反应时间，", "new": "设计师观点：“熠闪舞”可能会造成较为严重的视觉干扰，导致玩家难以在激烈战斗中追踪安燃的行动。为了提升清晰度，我们移除了可见的视觉分身。我们还缩短了“朱魂返”的施放时间，从而削减短对手的反应时间。"}, {"path": "sections[3].heroes[3].abilities[2].name_en", "old": null, "new": "Tremor Charge"}, {"path": "sections[3].heroes[4].abilities[0].name_en", "old": null, "new": "Teleporter"}, {"path": "sections[3].heroes[5].abilities[0].name_en", "old": null, "new": "Rivet Gun"}, {"path": "sections[3].heroes[7]", "old": null, "new": {"slug": "widowmaker", "name_en": "Widowmaker", "name_cn": "黑百合", "role": "damage", "icon": "https://ld5.res.netease.com/images/20260909/1788938368437_86814e5509.png", "dev_note": null, "general": [], "perks": [{"name_en": null, "name_cn": "锚固螺栓", "status": "changed", "lines_en": [], "lines_cn": ["部署炮台时的投掷距离加成从50%降低至25%。"], "raw_text": []}], "abilities": [{"name_en": "Take Aim", "name_cn": "瞄准射击", "slug": "take-aim", "icon": "https://ld5.res.netease.com/images/20260909/1788938368421_dd6ee12ba9.png", "changes": [{"text_en": null, "text_cn": "更新了黑百合默认武器、神话武器和凯蒂猫武器的瞄准充能音效。充能程度超过 50% 后，音效的强度会增强。", "before": null, "after": null, "by": null, "by_pct": null, "metric": null, "raw_metric": null, "unit": null}]}], "stadium_items": []}}, {"path": "sections[4].heroes[1].general[0]", "old": {"text_en": null, "text_cn": "生命值从200点降低至175点。", "subject": "health", "dimension": "hero_attr", "before": 200.0, "after": 175.0, "by": -25.0, "by_pct": null, "metric": "health", "unit": "hp"}, "new": "生命值从200点降低至175点。"}, {"path": "sections[4].heroes[1].general[1]", "old": {"text_en": null, "text_cn": "护甲从50点提升至75点。", "subject": "health", "dimension": "hero_attr", "before": 50.0, "after": 75.0, "by": 25.0, "by_pct": null, "metric": "armor", "unit": "hp"}, "new": "护甲从50点提升至75点。"}, {"path": "sections[4].heroes[2].general[0]", "old": {"text_en": null, "text_cn": "提升了基础移动和“咻咻飞”的音效优先级和音量。", "subject": null, "dimension": "other", "before": null, "after": null, "by": null, "by_pct": null, "metric": null, "unit": null}, "new": "提升了基础移动和“咻咻飞”的音效优先级和音量。"}, {"path": "sections[4].heroes[4].abilities[0].name_en", "old": null, "new": "Restorative Stream"}, {"path": "sections[4].heroes[5].abilities[0].name_en", "old": "Orb of Harmony", "new": "Harmony Orb"}, {"path": "sections[4].heroes[5].abilities[0].slug", "old": "orb-of-harmony", "new": "harmony-orb"}]}
